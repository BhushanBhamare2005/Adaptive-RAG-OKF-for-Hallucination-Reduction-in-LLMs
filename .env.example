# Backend
APP_NAME=Adaptive-RAG-OKF
DATABASE_URL=sqlite:///./storage/app.db
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=
LLM_MODEL=llama3.2:1b
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=hash-v1
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./storage/chroma
AEVL_MAX_LOOPS=3
ABSTENTION_RISK_THRESHOLD=0.75
SUPPORTED_CLAIM_THRESHOLD=0.70
CONTRADICTION_THRESHOLD=0.70
RETRIEVAL_TOP_K=8
DOCUMENT_MAX_SIZE_MB=50
CORS_ORIGINS=http://localhost:5174

# Frontend (create frontend/.env with these values)
VITE_API_URL=/api
VITE_PORT=5174
VITE_PROXY_TARGET=http://127.0.0.1:8001
